{
  "name": "patterns-mcp",
  "version": "0.1.0",
  "description": "An MCP server that generates TypeScript pattern implementations, typechecked and tested before they are returned.",
  "license": "MIT",
  "author": "Daniel Perussina <daniel@perussina.com>",
  "mcpName": "com.perussina/patterns",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dperussina/patterns-mcp.git"
  },
  "homepage": "https://github.com/dperussina/patterns-mcp#readme",
  "bugs": {
    "url": "https://github.com/dperussina/patterns-mcp/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "bin": {
    "patterns-mcp": "./dist/mcp/transports/stdio-bin.mjs",
    "patterns-mcp-http": "./dist/mcp/transports/http-bin.mjs",
    "patterns": "./dist/cli/bin.mjs"
  },
  "files": [
    "dist",
    "data",
    "skills"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "patterns": "tsx src/cli/bin.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --project unit --coverage.enabled --coverage.provider=v8 --coverage.include='src/**' --coverage.reporter=text",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc --noEmit",
    "schema:emit": "tsx scripts/emit-catalog-schema.ts",
    "schema:check": "tsx scripts/emit-catalog-schema.ts --check",
    "docs:emit": "tsx scripts/emit-docs.ts",
    "docs:check": "tsx scripts/emit-docs.ts --check",
    "catalog:check": "tsx scripts/validate-catalog.ts",
    "smoke": "tsx scripts/smoke-packaged.ts",
    "serve:http": "tsx src/mcp/transports/http-bin.ts",
    "conformance:http": "tsx scripts/conformance-http.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm schema:check && pnpm docs:check && pnpm catalog:check && pnpm test && pnpm conformance:http && pnpm build && pnpm smoke",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "typescript",
    "code-generation",
    "design-patterns"
  ],
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/conformance": "0.1.16",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "oxlint": "1.77.0",
    "prettier": "3.9.6",
    "tsdown": "^0.22.14",
    "tsx": "4.23.11",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "typescript": "7.0.2",
    "typescript-stable": "npm:typescript@6.0.3",
    "zod": "4.4.3"
  }
}
