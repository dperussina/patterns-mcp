{
  "name": "patterns",
  "version": "0.1.0",
  "description": "",
  "license": "MIT",
  "author": "",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc --noEmit",
    "schema:emit": "tsx scripts/emit-catalog-schema.ts",
    "schema:check": "tsx scripts/emit-catalog-schema.ts --check",
    "check": "pnpm lint && pnpm typecheck && pnpm schema:check && pnpm test && pnpm build",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [],
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "oxlint": "1.77.0",
    "prettier": "3.9.6",
    "tsdown": "^0.22.14",
    "tsx": "4.23.11",
    "typescript": "7.0.2",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.4.3"
  }
}
